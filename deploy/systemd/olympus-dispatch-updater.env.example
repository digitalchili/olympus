# Install as /etc/olympus-dispatch-updater.env with mode 0600.
OLYMPUS_UPDATER_SOCKET=/var/lib/olympus-dispatch-updater/socket/update.sock
OLYMPUS_UPDATER_SOCKET_GID=10000
OLYMPUS_UPDATER_TOKEN=replace-with-the-same-64-hex-character-secret-used-by-the-app
OLYMPUS_UPDATER_REPOSITORY=digitalchili/olympus

# These values lock the updater to exactly one local Compose project/service.
OLYMPUS_UPDATER_COMPOSE_DIR=/absolute/path/to/the/compose/project
OLYMPUS_UPDATER_COMPOSE_FILE=docker-compose.yml
OLYMPUS_UPDATER_COMPOSE_PROJECT=replace-with-live-com-docker-compose-project-label
OLYMPUS_UPDATER_SERVICE=olympus-dispatch
OLYMPUS_UPDATER_ENV_FILE=/absolute/path/to/the/compose/project/.env
OLYMPUS_UPDATER_IMAGE_REPOSITORY=ghcr.io/digitalchili/olympus
OLYMPUS_UPDATER_IMAGE_SOURCE=https://github.com/digitalchili/olympus
# Required only while the GHCR package is private; use a classic PAT with read:packages only.
OLYMPUS_UPDATER_GHCR_USERNAME=your-github-username
OLYMPUS_UPDATER_GHCR_TOKEN=
OLYMPUS_UPDATER_BACKUP_DIR=/var/lib/olympus-dispatch-updater/backups
OLYMPUS_UPDATER_LOCK_DIR=/var/lib/olympus-dispatch-updater/operation.lock

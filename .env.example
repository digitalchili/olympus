# All optional — defaults work for local development
PORT=6969
HERMES_PYTHON=                          # Path to Python with Hermes deps (auto-detected if unset)
HERMES_AGENT_DIR=~/.hermes/hermes-agent # Path to Hermes agent installation
HERMES_AGENT_RUN_LIMIT=10              # Max concurrent agent runs in Python worker
HEARTBEAT_CONCURRENCY=2
OLYMPUS_DISPATCH_HOME=~/.olympus-dispatch
DB_PATH=~/.olympus-dispatch/data/olympus-dispatch.db
OLYMPUS_DISPATCH_PROJECT_ROOT=~/Dev       # Root for the host-side project-folder picker

# Dokploy/Tailscale deployment (no secrets; production uses a persisted Dokploy .env)
OLYMPUS_DISPATCH_IMAGE_TAG=dev
OLYMPUS_DISPATCH_BIND_ADDRESS=100.67.241.67
OLYMPUS_DISPATCH_PORT=6969
OLYMPUS_DISPATCH_STATE_VOLUME=somboon-vps-olympus-dispatch-state
HERMES_DATA_VOLUME=somboon-vps-somboon-vps-p3iges_hermes_data
SOMBOON_RUNTIME_NETWORK=som_internal

# Remote Hermes execution routing. Olympus runs on this Mac; execution agents run on the Somboon VPS.
# Store only secret env var names in JSON. Put actual API_SERVER_KEY values in separate env vars.
# For multiplexed gateways, include the /p/<profile> prefix in baseUrl; remoteProfile is not sent in the JSON body.
# OLYMPUS_REMOTE_PROFILES_PATH=/path/to/remote-profiles.json
# OLYMPUS_REMOTE_PROFILES_JSON={"som":{"baseUrl":"$SOM_HERMES_GATEWAY_PROFILE_URL","apiKeyEnv":"SOM_API_SERVER_KEY"},"somchai":{"baseUrl":"$SOMCHAI_HERMES_GATEWAY_URL","apiKeyEnv":"SOMCHAI_API_SERVER_KEY"},"somboon":{"baseUrl":"$SOMBOON_HERMES_GATEWAY_URL","apiKeyEnv":"SOMBOON_API_SERVER_KEY"}}
# SOM_HERMES_GATEWAY_PROFILE_URL=        # Example: https://gateway.example.test/p/som-spirithouse-wine
# SOM_API_SERVER_KEY=
# SOMCHAI_HERMES_GATEWAY_URL=            # Root URL is OK for a dedicated Somchai gateway
# SOMCHAI_API_SERVER_KEY=
# SOMBOON_HERMES_GATEWAY_URL=            # Root URL is OK for the default gateway profile
# SOMBOON_API_SERVER_KEY=

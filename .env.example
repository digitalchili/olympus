PORT=6969
# Loopback by default. Olympus has no authentication of its own — only widen this
# deliberately, and put it behind something that does authenticate.
HOST=127.0.0.1
HERMES_PYTHON=
HERMES_AGENT_DIR=~/.hermes/hermes-agent
HERMES_AGENT_RUN_LIMIT=10
HEARTBEAT_CONCURRENCY=2
OLYMPUS_DISPATCH_HOME=~/.olympus-dispatch
DB_PATH=~/.olympus-dispatch/data/olympus-dispatch.db
OLYMPUS_DISPATCH_PROJECT_ROOT=~/Dev

OLYMPUS_DISPATCH_IMAGE=ghcr.io/digitalchili/olympus:0.3.0
OLYMPUS_DISPATCH_BIND_ADDRESS=127.0.0.1
OLYMPUS_DISPATCH_PORT=6969
# Docker storage volumes (defaults to local host disk volumes).
# See docs/storage.md for attached volume or SSHFS/NFS setup.
OLYMPUS_DISPATCH_STATE_VOLUME=olympus-dispatch-state
HERMES_DATA_VOLUME=hermes-data
OLYMPUS_MAINTENANCE_TOKEN=
OLYMPUS_DRAIN_TIMEOUT_MS=120000
# Bound one foreground Hermes turn so a silent provider/tool stall or a busy
# tool-call loop cannot leave a task streaming forever. Override only when a
# known workload genuinely needs a larger foreground budget.
OLYMPUS_CHAT_IDLE_TIMEOUT_MS=300000
OLYMPUS_CHAT_MAX_RUN_MS=3600000
# Reserve the final five minutes for checkpointing/reconciliation. Two minutes
# before the hard limit, Olympus interrupts remaining children so the parent can
# produce one bounded final response instead of losing late review results.
OLYMPUS_CHAT_FINALIZE_BEFORE_MS=300000
OLYMPUS_CHAT_CHILD_DRAIN_BEFORE_MS=120000
# Cumulative child cap for one run. This prevents one broad review fan-out from
# consuming the entire foreground runtime.
OLYMPUS_CHAT_MAX_DELEGATED_CHILDREN=4
OLYMPUS_AGENT_MAX_ITERATIONS=40

# Studio GitHub onboarding works without pre-created credentials: the first
# Connect GitHub flow lets the user choose a personal account or enter an
# organization handle, then stores generated credentials encrypted in the
# persistent Olympus state volume.
# Optional canonical origin override. Normally Olympus derives the HTTPS origin
# from the browser and Dokploy proxy headers.
OLYMPUS_STUDIO_PUBLIC_URL=
# Optional advanced override for an existing GitHub App. If used, provide all
# five values. Metadata: Read only remains the only repository permission.
OLYMPUS_STUDIO_GITHUB_APP_ID=
OLYMPUS_STUDIO_GITHUB_APP_SLUG=
OLYMPUS_STUDIO_GITHUB_PRIVATE_KEY=
OLYMPUS_STUDIO_GITHUB_CLIENT_ID=
OLYMPUS_STUDIO_GITHUB_CLIENT_SECRET=

# Optional installation-local self-update runner (see docs/standalone-self-update.md).
OLYMPUS_DISPATCH_GITHUB_REPOSITORY=https://github.com/digitalchili/olympus.git
OLYMPUS_DISPATCH_GITHUB_TOKEN=
OLYMPUS_DISPATCH_UPDATE_SOCKET=
OLYMPUS_DISPATCH_UPDATE_TOKEN=

PORT=6969
# Loopback by default. Olympus has no authentication of its own — only widen this
# deliberately, and put it behind something that does authenticate.
HOST=127.0.0.1
HERMES_PYTHON=
HERMES_AGENT_DIR=~/.hermes/hermes-agent
HERMES_AGENT_RUN_LIMIT=10
HEARTBEAT_CONCURRENCY=2
OLYMPUS_DISPATCH_HOME=~/.olympus-dispatch
DB_PATH=~/.olympus-dispatch/data/olympus-dispatch.db
OLYMPUS_DISPATCH_PROJECT_ROOT=~/Dev

OLYMPUS_DISPATCH_IMAGE=ghcr.io/digitalchili/olympus:0.3.0
OLYMPUS_DISPATCH_BIND_ADDRESS=127.0.0.1
OLYMPUS_DISPATCH_PORT=6969
OLYMPUS_DISPATCH_STATE_VOLUME=olympus-dispatch-state
HERMES_DATA_VOLUME=
OLYMPUS_MAINTENANCE_TOKEN=
OLYMPUS_DRAIN_TIMEOUT_MS=120000

# Optional Studio GitHub App onboarding. Leave all five blank to keep this
# feature disabled. For this read-only slice, grant repository Metadata: Read only
# and no other repository, organization, account, or webhook permissions.
OLYMPUS_STUDIO_GITHUB_APP_ID=
OLYMPUS_STUDIO_GITHUB_APP_SLUG=
OLYMPUS_STUDIO_GITHUB_PRIVATE_KEY=
OLYMPUS_STUDIO_GITHUB_CLIENT_ID=
OLYMPUS_STUDIO_GITHUB_CLIENT_SECRET=

# Optional installation-local self-update runner (see docs/standalone-self-update.md).
OLYMPUS_DISPATCH_GITHUB_REPOSITORY=https://github.com/digitalchili/olympus.git
OLYMPUS_DISPATCH_GITHUB_TOKEN=
OLYMPUS_DISPATCH_UPDATE_SOCKET=
OLYMPUS_DISPATCH_UPDATE_TOKEN=
